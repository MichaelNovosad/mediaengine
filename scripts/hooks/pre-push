#!/bin/bash
# Runs scripts/check.sh (build with zero warnings and the unit tests, under a minute, background priority, silent) before anything
# leaves the machine. The heavier checks (scripts/verify.sh) are run on request, not on every push.
# Skip with MEDIAENGINE_SKIP_HOOKS=1 git push ...
[ "${MEDIAENGINE_SKIP_HOOKS:-}" = 1 ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
mkdir -p build
echo "pre-push: scripts/check.sh"
scripts/check.sh >/dev/null 2>build/prepush.err || { tail -30 build/prepush.err >&2; echo "pre-push: check failed" >&2; exit 1; }
exit 0
