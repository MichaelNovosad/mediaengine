-static int alloc_x96_sample_buffer(DCACoreDecoder *s)
-{
-    int nchsamples = DCA_ADPCM_COEFFS + s->npcmblocks;
-    int nframesamples = nchsamples * DCA_CHANNELS * DCA_SUBBANDS_X96;
-    unsigned int size = s->x96_subband_size;
